// Generated by tools/mac-services.py from the native catalog and interface translations.
function PFSharingUILanguage: Word; external 'GetUserDefaultUILanguage@kernel32.dll stdcall';

function ShareMenuTaskDescription(Param: String): String;
var
  Language: Word;
begin
  Language := PFSharingUILanguage;
  case Language and $3FF of
    $04: begin
      if (Language = $0404) or (Language = $0C04) or (Language = $1404) then
        Result := '安裝選單: 透過隔空貼傳送'
      else
        Result := '安装菜单: 通过隔空贴发送';
    end;
    $11: Result := 'メニューを追加: PasteFerry で送信';
    $12: Result := '메뉴 설치: PasteFerry로 보내기';
    $01: Result := 'تثبيت القوائم: إرسال عبر PasteFerry';
    $07: Result := 'Menüs installieren: Mit PasteFerry senden';
    $0C: Result := 'Installer les menus: Envoyer avec PasteFerry';
    $0A: Result := 'Instalar menús: Enviar con PasteFerry';
    $16: Result := 'Instalar menus: Enviar com PasteFerry';
    $10: Result := 'Installa menu: Invia con PasteFerry';
    $19: Result := 'Установить меню: Отправить через PasteFerry';
    $22: Result := 'Установити меню: Надіслати через PasteFerry';
    $15: Result := 'Zainstaluj menu: Wyślij przez PasteFerry';
    $1F: Result := 'Menüleri yükle: PasteFerry ile gönder';
    $2A: Result := 'Cài menu: Gửi bằng PasteFerry';
    $21: Result := 'Pasang menu: Kirim dengan PasteFerry';
  else
    Result := 'Install menus: Send with PasteFerry';
  end;
end;
