<?xml version="1.0" encoding="utf-8"?>
<!-- 数据目录里有设备私钥与配对关系，不参与云备份和设备迁移（design/phone-sync.md 3.3.2 节第 8 条） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
